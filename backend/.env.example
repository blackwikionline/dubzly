# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_METER_ID=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=anime-dub-audio
R2_PUBLIC_URL=

# Content-addressed audio cache (S3). Bucket name; empty = cache disabled.
# In production, IAM access is via the App Runner instance role; locally,
# boto3 picks up your default AWS credentials. Cache is a pure optimization
# and degrades gracefully when unset.
S3_AUDIO_CACHE_BUCKET=

# App
APP_ENV=development
APP_PORT=8000
EXTENSION_ORIGIN=chrome-extension://<your-extension-id>
