{
  "manifest_version": 3,
  "name": "Dubzly — AI dub for subtitled anime",
  "short_name": "Dubzly",
  "version": "0.1.1",
  "description": "Mutes the original audio on Crunchyroll and reads every line of dialogue aloud with a distinct AI voice per character.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.crunchyroll.com/*",
    "https://*.crunchyrollcdn.com/*",
    "https://api.dubzly.com/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.crunchyroll.com/watch/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.crunchyroll.com/watch/*"],
      "js": ["src/content/page-injector.ts"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Dubzly",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png",
      "48": "src/icons/icon-48.png",
      "128": "src/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "homepage_url": "https://dubzly.com"
}
